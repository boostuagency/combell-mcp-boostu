# BoostU Combell MCP: copy to .env and fill in (see docs/AUTHENTICATION.md)
# Required: API key and secret from your Combell control panel (My Combell > API)
COMBELL_API_KEY=
COMBELL_API_SECRET=

# Optional: restrict which tool groups are exposed (comma-separated; unset = all).
# Group keys: accounts,provisioning,domains,dns,linuxHostings,scheduledTasks,ssh,
# windowsHostings,mailboxes,mailZones,mysql,ssl
# COMBELL_TOOLS=domains,dns,mailboxes

# Optional: override the API base URL (default https://api.combell.com)
# COMBELL_API_BASE_URL=https://api.combell.com
